{
  "name": "@klank/sdk",
  "version": "0.1.0",
  "description": "Bot SDK for Klank, the self-hosted E2EE team chat — webhooks, typed events, slash command verification",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && tsup",
    "build:js": "tsup",
    "build:types": "tsc -b tsconfig.build.json",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "vitest run",
    "tarball:check": "pnpm pack --pack-destination ./.pack-tmp && tar -tzf ./.pack-tmp/*.tgz | LC_ALL=C sort > .tarball-actual.txt && diff -u .tarball-snapshot.txt .tarball-actual.txt && rm -rf ./.pack-tmp .tarball-actual.txt",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/ws": "^8.5.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "klank",
    "bot",
    "sdk",
    "chat",
    "messaging",
    "webhook",
    "e2ee"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Aktiga/klank-sdk/tree/main/packages/sdk#readme",
  "bugs": "https://github.com/Aktiga/klank-sdk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aktiga/klank-sdk.git",
    "directory": "packages/sdk"
  }
}
