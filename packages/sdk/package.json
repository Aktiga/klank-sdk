{
  "name": "@klank/sdk",
  "version": "0.1.0",
  "description": "Bot SDK for Klank — build bots with event listeners, command routing, and more",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && tsup",
    "build:js": "tsup",
    "build:types": "tsc -b tsconfig.build.json",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "vitest run",
    "tarball:check": "pnpm pack --pack-destination ./.pack-tmp && tar -tzf ./.pack-tmp/*.tgz | sort > .tarball-actual.txt && diff -u .tarball-snapshot.txt .tarball-actual.txt && rm -rf ./.pack-tmp .tarball-actual.txt"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  },
  "keywords": ["klank", "bot", "sdk", "chat", "messaging"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aktiga/klank-sdk"
  }
}
