{
  "name": "@klank/sdk",
  "version": "0.1.0",
  "description": "Bot SDK for Klank — build bots with event listeners, command routing, and more",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest"
  },
  "dependencies": {
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "@types/ws": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "keywords": ["klank", "bot", "sdk", "chat", "messaging"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aktiga/klank-sdk"
  }
}
