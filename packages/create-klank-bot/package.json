{
  "name": "create-klank-bot",
  "version": "0.1.0",
  "description": "Scaffold a Klank bot project: npm create klank-bot",
  "type": "module",
  "bin": {
    "create-klank-bot": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "build:js": "tsup",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@klank/sdk": "workspace:*",
    "@types/node": "^20",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "klank",
    "bot",
    "create",
    "scaffold"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Aktiga/klank-sdk/tree/main/packages/create-klank-bot#readme",
  "bugs": "https://github.com/Aktiga/klank-sdk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aktiga/klank-sdk.git",
    "directory": "packages/create-klank-bot"
  }
}
